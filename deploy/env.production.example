# Copy to /opt/streetwise/app/.env on the server and fill in the blanks.
# Then lock it down:  sudo chown streetwise:streetwise .env && sudo chmod 600 .env
# Never commit the real file.

# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=YOUR_DOMAIN
DJANGO_TIME_ZONE=America/New_York

POSTGRES_DB=streetwise
POSTGRES_USER=streetwise
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Gmail app password (not the normal password). Without it, no email is sent.
EMAIL_HOST_USER=streetwisefall2026cohort@gmail.com
EMAIL_HOST_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=streetwisefall2026cohort@gmail.com

# The public address of the site. Used for the edit and cancel link in emails.
FRONTEND_BASE_URL=https://YOUR_DOMAIN
# Same site for the API and the React app, so these just match the domain.
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN
CSRF_TRUSTED_ORIGINS=https://YOUR_DOMAIN

# nginx sits in front of Django. Without this line every visitor looks like
# the same person to the rate limit.
NUM_PROXIES=1

# HTTPS is handled by nginx and certbot. Start low. Raise it once HTTPS is
# confirmed working, because browsers remember it.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=3600

# Spam limits per visitor address, and how long the edit link lasts.
EVENT_SUBMIT_RATE=10/hour
MANAGE_RATE=60/hour
MANAGE_LINK_GRACE_DAYS=3
