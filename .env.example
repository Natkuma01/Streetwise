# Copy this file to .env and fill in real values.
# Never commit the real .env file.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/New_York

POSTGRES_DB=streetwise
POSTGRES_USER=streetwise
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Email. Leave the password blank in local development and emails print to
# the terminal instead. For real sending, use a Gmail APP PASSWORD (Google
# Account > Security > 2-Step Verification > App passwords), not the normal
# password. Ask Nat for it. Never commit it.
EMAIL_HOST_USER=streetwisefall2026cohort@gmail.com
EMAIL_HOST_PASSWORD=
# Who gets the "new event is waiting" heads-up. Defaults to EMAIL_HOST_USER.
ADMIN_NOTIFICATION_EMAIL=streetwisefall2026cohort@gmail.com
# Address of the React site. Used to build the edit and cancel link in emails.
FRONTEND_BASE_URL=http://localhost:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production only (used when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=3600
